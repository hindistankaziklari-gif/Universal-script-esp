local function refreshDoorList()
    DoorList = {}
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if isDoor(inst) then table.insert(DoorList, inst) end
    end
    lastDoorRefresh = tick()
end

local function refreshRoomNumber()
    local val = "N/A"
    for _, attr in ipairs({"Room","RoomNumber","Level","Floor","Stage","RoomIndex"}) do
        local v = LocalPlayer:GetAttribute(attr) or Workspace:GetAttribute(attr)
        if v ~= nil then val = tostring(v) break end
    end
    if val == "N/A" then
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Model") and inst.Name:lower():find("room", 1, true) then
                local nv = inst:FindFirstChildWhichIsA("NumberValue", true)
                if nv then val = tostring(nv.Value) break end
                local n = inst.Name:match("%d+")
                if n then val = n break end
            end
        end
    end
    cachedRoom = val
    lastRoomRefresh = tick()
end

local function nearestDoorDistance()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best
    for _, inst in ipairs(DoorList) do
        if inst.Parent then
            local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (part.Position - hrp.Position).Magnitude
                if not best or d < best then best = d end
            end
        end
    end
    return best
end

