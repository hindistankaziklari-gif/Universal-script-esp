local function createToggle(label, initial, callback)
    local row = new("TextButton", {
        Size = UDim2.new(1,0,0,42), BackgroundColor3 = Theme.Surface,
        AutoButtonColor = false, BorderSizePixel = 0, Text = "", Parent = body,
    })
    corner(row, Theme.CornerS)
    local rs = stroke(row, Theme.Accent, 1, 0.55)
    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0,14,0,0),
        Size = UDim2.new(1,-80,1,0), Font = Enum.Font.GothamMedium,
        Text = label, TextColor3 = Theme.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
    })
    local track = new("Frame", {
        Size = UDim2.fromOffset(42,22), Position = UDim2.new(1,-56,0.5,-11),
        BackgroundColor3 = Theme.SurfaceHov, BorderSizePixel = 0, Parent = row,
    })
    corner(track, Theme.CornerR)
    local trackStroke = stroke(track, Theme.TextDim, 1, 0.4)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(16,16), Position = UDim2.new(0,3,0.5,-8),
        BackgroundColor3 = Theme.TextDim, BorderSizePixel = 0, Parent = track,
    })
    corner(knob, Theme.CornerR)

    local state = initial and true or false
    local function render(anim)
        local t = anim and Theme.Med or 0
        if state then
            tween(track, t, {BackgroundColor3 = Theme.Accent})
            tween(trackStroke, t, {Color = Theme.Accent, Transparency = 0})
            tween(knob, t, {Position = UDim2.new(1,-19,0.5,-8), BackgroundColor3 = Color3.new(1,1,1)})
            tween(rs, t, {Transparency = 0, Thickness = 1.5})
        else
            tween(track, t, {BackgroundColor3 = Theme.SurfaceHov})
            tween(trackStroke, t, {Color = Theme.TextDim, Transparency = 0.4})
            tween(knob, t, {Position = UDim2.new(0,3,0.5,-8), BackgroundColor3 = Theme.TextDim})
            tween(rs, t, {Transparency = 0.55, Thickness = 1})
        end
    end
    render(false)

    row.MouseEnter:Connect(function() tween(row, Theme.Fast, {BackgroundColor3 = Theme.SurfaceHov}) end)
    row.MouseLeave:Connect(function() tween(row, Theme.Med, {BackgroundColor3 = Theme.Surface}) end)
    local function flip()
        state = not state
        render(true)
        if callback then callback(state) end
    end
    row.Activated:Connect(flip)
    return { set = function(v) state = v render(true) end, get = function() return state end }
end

