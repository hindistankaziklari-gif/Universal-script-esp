Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("Model") then
        task.defer(function()
            if not inst.Parent then return end
            if isMonster(inst) then addMonster(inst) end
            if isCollectible(inst) then addCollectible(inst) end
            if isDoor(inst) then table.insert(DoorList, inst) end
        end)
    elseif inst:IsA("Humanoid") then
        local m = inst.Parent
        if m and m:IsA("Model") and isMonster(m) then addMonster(m) end
    elseif inst:IsA("ProximityPrompt") then
        local p = inst.Parent
        if p and isCollectible(p) then addCollectible(p) end
    end
end)

Workspace.DescendantRemoving:Connect(function(inst)
    if MonsterData[inst] then removeMonster(inst) end
    if CollectData[inst] then removeCollectible(inst) end
end)

