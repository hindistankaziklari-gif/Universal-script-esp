----------------------------------------------------------------
-- HEURISTICS
----------------------------------------------------------------
local COLLECT_PATTERNS = {
    "coin","gem","collect","pickup","loot","item","token","cash","star",
    "orb","ticket","candy","crystal","chest"
}
local DOOR_PATTERNS  = { "door", "gate", "exit", "entrance", "portal" }

local function hasPattern(name, patterns)
    local lower = name:lower()
    for _, p in ipairs(patterns) do
        if lower:find(p, 1, true) then return true end
    end
    return false
end

local function isMonster(model)
    if not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function isCollectible(inst)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    if hasPattern(inst.Name, COLLECT_PATTERNS) then return true end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("ProximityPrompt") then return true end
    if inst:IsA("BasePart") and inst:FindFirstChildOfClass("ProximityPrompt") then return true end
    return false
end

local function isDoor(inst)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    return hasPattern(inst.Name, DOOR_PATTERNS)
end

