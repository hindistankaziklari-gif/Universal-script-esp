-- WINDOW STATE MACHINE
----------------------------------------------------------------
local windowState = "closed"

local function openWindow()
    windowState = "open"
    window.Visible = true
    windowScale.Scale = 0.85
    window.BackgroundTransparency = 0.4
    windowStroke.Transparency = 0.6
    tween(windowScale, 0.28, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    tween(window, 0.22, {BackgroundTransparency = 0})
    tween(windowStroke, 0.22, {Transparency = 0.1})
    tween(toggle, 0.2, {Size = UDim2.fromOffset(44,44)})
end

local function closeWindow()
    windowState = "closed"
    tween(windowScale, 0.2, {Scale = 0.85}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(window, 0.2, {BackgroundTransparency = 1})
    tween(windowStroke, 0.2, {Transparency = 1})
    tween(toggle, 0.2, {Size = UDim2.fromOffset(56,56)})
    task.delay(0.2, function()
        if windowState == "closed" then window.Visible = false end
    end)
end

toggle.Activated:Connect(function()
    if dragMoved[toggle] then dragMoved[toggle] = false return end
    if windowState == "open" then closeWindow() else openWindow() end
end)
closeBtn.Activated:Connect(closeWindow)

