local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Highlights = {}

-- Enable ESP for a character
local function applyESP(char)
    if not char or Highlights[char] then return end
    local h = Instance.new("Highlight")
    h.Name = "BludESP"
    h.FillTransparency = 1
    h.OutlineColor = Color3.fromRGB(255, 120, 0) -- orange outline
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = char
    h.Parent = char
    Highlights[char] = h
end

-- Apply to existing players
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        applyESP(plr.Character or plr.CharacterAdded:Wait())
    end
end

-- Apply to players who join later
Players.PlayerAdded:Connect(function(plr)
    if plr ~= LocalPlayer then
        plr.CharacterAdded:Connect(applyESP)
        if plr.Character then applyESP(plr.Character) end
    end
end)

print("Universal ESP loaded")
