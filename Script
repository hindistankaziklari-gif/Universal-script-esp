local function applyMonsterVisuals(model)
    local d = MonsterData[model]
    if not d then return end

    if Features.MonsterESP and not d.highlight then
        d.highlight = makeHighlight(model, Color3.new(1,1,1), 0.5)
    elseif not Features.MonsterESP and d.highlight then
        d.highlight:Destroy(); d.highlight = nil
    end

    if Features.MonsterInfo and not d.billboard then
        local bb, lbl = makeInfoBillboard(model)
        d.billboard, d.label = bb, lbl
    elseif not Features.MonsterInfo and d.billboard then
        d.billboard:Destroy(); d.billboard = nil; d.label = nil
    end
end

local function addMonster(model)
    if MonsterData[model] then return end
    MonsterData[model] = {}
    applyMonsterVisuals(model)
end

local function removeMonster(model)
    local d = MonsterData[model]
    if not d then return end
    if d.highlight then d.highlight:Destroy() end
    if d.billboard then d.billboard:Destroy() end
    MonsterData[model] = nil
end

local function scanMonsters()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if isMonster(inst) then addMonster(inst) end
    end
end

local function refreshAllMonsterVisuals()
    for model in pairs(MonsterData) do
        if model.Parent then applyMonsterVisuals(model) else removeMonster(model) end
    end
end

