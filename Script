local listEntries = {}
local lastListSig = ""
local function updateMonsterList(list)
    local sig = ""
    for i, e in ipairs(list) do
        sig = sig .. e.name .. "|" .. tostring(math.floor(e.dist)) .. ";"
    end
    if sig == lastListSig then return end
    lastListSig = sig

    for _, f in ipairs(listEntries) do f:Destroy() end
    listEntries = {}
    if #list == 0 then
        table.insert(listEntries, new("TextLabel", {
            Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1,
            Font = Enum.Font.Gotham, Text = "no monsters detected",
            TextColor3 = Theme.TextDim, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = listFrame,
        }))
        return
    end
    for i, e in ipairs(list) do
        table.insert(listEntries, new("TextLabel", {
            Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Text = string.format("%d. %s — %.0f studs", i, e.name, e.dist),
            TextColor3 = Theme.Text, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = listFrame,
        }))
    end
end

----------------------------------------------------------------
-- HEARTBEAT (throttled)
----------------------------------------------------------------
local acc = 0
RunService.Heartbeat:Connect(function(dt)
    acc += dt
    if acc < 0.2 then return end
    acc = 0

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    if Features.MonsterInfo and hrp then
        local entries = {}
        for model, d in pairs(MonsterData) do
            if model.Parent then
                local mhrp = model:FindFirstChild("HumanoidRootPart")
                if mhrp and d.label then
                    local dist = (mhrp.Position - hrp.Position).Magnitude
                    d.label.Text = string.format("%s  |  %dm", model.Name, math.floor(dist))
                    table.insert(entries, { name = model.Name, dist = dist })
                end
            else
                removeMonster(model)
            end
        end
        table.sort(entries, function(a,b) return a.dist < b.dist end)
        updateMonsterList(entries)
    elseif lastListSig ~= "" then
        updateMonsterList({})
    end

    if Features.DoorInfo then
        if tick() - lastDoorRefresh > 2 then
            task.spawn(function() pcall(refreshDoorList) end)
        end
        if tick() - lastRoomRefresh > 2 then
            task.spawn(function() pcall(refreshRoomNumber) end)
        end
        local d = nearestDoorDistance()
        doorRow.set(d and string.format("%.0f studs", d) or "none")
        roomRow.set(cachedRoom)
    else
        doorRow.set("—")
        roomRow.set("—")
    end

    if Features.AutoCollect then pcall(autoCollectTick) end
end)

