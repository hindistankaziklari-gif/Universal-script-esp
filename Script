----------------------------------------------------------------
-- AUTO COLLECT
----------------------------------------------------------------
local COLLECT_COOLDOWN = 1.2
local lastCollect = 0

local function getPrompt(inst)
    local p = inst:FindFirstChildOfClass("ProximityPrompt")
    if p then return p end
    if inst:IsA("Model") then return inst:FindFirstChildWhichIsA("ProximityPrompt", true) end
    return nil
end

local function firePromptSafe(prompt)
    if type(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return true
    end
    return false
end

local function autoCollectTick()
    if tick() - lastCollect < COLLECT_COOLDOWN then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local nearest, nearestDist
    for inst in pairs(CollectData) do
        if inst.Parent then
            local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (part.Position - hrp.Position).Magnitude
                if not nearestDist or dist < nearestDist then
                    nearest, nearestDist = inst, dist
                end
            end
        end
    end
    if not nearest then return end

    lastCollect = tick()
    local prompt = getPrompt(nearest)
    if prompt and firePromptSafe(prompt) then return end

    local part = nearest:IsA("BasePart") and nearest or nearest:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    local originCF = hrp.CFrame
    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.15)
    if hrp and hrp.Parent then hrp.CFrame = originCF end
end

