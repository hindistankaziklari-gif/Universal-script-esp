local function addPlayerESP(player)
    if player == LocalPlayer then return end
    if PlayerESPData[player] then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if not char:FindFirstChild("HumanoidRootPart") then return end
    PlayerESPData[player] = { highlight = makeHighlight(char, Color3.new(1,1,1), 0.5) }
end

local function removePlayerESP(player)
    local d = PlayerESPData[player]
    if not d then return end
    if d.highlight then d.highlight:Destroy() end
    PlayerESPData[player] = nil
end

local function refreshAllPlayerESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if Features.PlayerESP then addPlayerESP(p) else removePlayerESP(p) end
        end
    end
end

local function hookPlayer(p)
    if p == LocalPlayer then return end
    p.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart", 5)
        if Features.PlayerESP then addPlayerESP(p) end
    end)
    p.CharacterRemoving:Connect(function() removePlayerESP(p) end)
end

for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(removePlayerESP)

